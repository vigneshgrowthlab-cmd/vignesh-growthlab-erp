# ─── Application ───────────────────────────────────────────
APP_NAME="Wholesale ERP"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wholesale_erp
DB_USER=erp_user
DB_PASSWORD=erp_password
DATABASE_URL=mysql+pymysql://erp_user:erp_password@localhost:3306/wholesale_erp

# ─── Redis / Celery ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── File Storage ───────────────────────────────────────────
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_SIZE_MB=10

# ─── Company Info ───────────────────────────────────────────
COMPANY_NAME="Your Company Name"
COMPANY_GSTIN=29AAAAA0000A1Z5
COMPANY_STATE=Karnataka
COMPANY_STATE_CODE=29
COMPANY_ADDRESS="123, Business Street, City - 560001"
COMPANY_PHONE=+91-9999999999
COMPANY_EMAIL=accounts@yourcompany.com
FINANCIAL_YEAR_START_MONTH=4

# ─── Cleartax API ───────────────────────────────────────────
CLEARTAX_API_URL=https://einvoicing.internal.cleartax.co
CLEARTAX_AUTH_TOKEN=your-cleartax-token-here
CLEARTAX_GSTIN=29AAAAA0000A1Z5
CLEARTAX_SANDBOX=True

# ─── GSTIN Lookup ───────────────────────────────────────────
GSTIN_LOOKUP_URL=https://api.cleartax.in/user/gstin/
GSTIN_LOOKUP_TOKEN=your-gstin-lookup-token

# ─── Frontend URL (CORS) ────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
