# ─── PRODUCTION .env TEMPLATE — copy to backend/.env on the server, then fill ──
# This template is safe to commit (no secrets). The real backend/.env is gitignored.
#   cp .env.production.template .env   &&   nano .env
# pydantic-settings loads this from the process CWD (= systemd WorkingDirectory).

# ─── Application ───────────────────────────────────────────
APP_NAME="Wholesale ERP"
APP_VERSION="1.0.0"
DEBUG=false                         # MUST be false in prod (disables /api/docs)
# Generate on the server:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=__PASTE_GENERATED_SECRET_KEY__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (CloudPanel Percona MySQL 8.4, local socket on :3306) ──────────
# Create DB + user in CloudPanel → Databases. Put the password here only on the server.
DATABASE_URL=mysql+pymysql://erpuser:__DB_PASSWORD__@localhost:3306/wholesaleerp?charset=utf8mb4

# ─── File Storage (absolute paths so they resolve regardless of CWD) ─────────
UPLOAD_DIR=/home/gtferp/GTF/backend/uploads
EXPORT_DIR=/home/gtferp/GTF/backend/exports
MAX_UPLOAD_SIZE_MB=10

# ─── Company Info (edit to the real business details) ────────────────────────
COMPANY_NAME="Global Trade Force"
COMPANY_GSTIN=29AAAAA0000A1Z5
COMPANY_STATE=Karnataka
COMPANY_STATE_CODE=29
COMPANY_ADDRESS="123, Business Street, City - 560001"
COMPANY_CITY=Bangalore
COMPANY_PINCODE=560001
COMPANY_PHONE=+91-9999999999
COMPANY_EMAIL=accounts@globaltradeforce.com
FINANCIAL_YEAR_START_MONTH=4

# ─── Cleartax / GST (keep SANDBOX=true until you have a real token) ──────────
CLEARTAX_SANDBOX=true
CLEARTAX_AUTH_TOKEN=
CLEARTAX_GSTIN=

# ─── CORS — same-origin in prod, but set the domain as a safety net ──────────
FRONTEND_URL=https://erp.globaltradeforce.com
ALLOWED_ORIGINS=["https://erp.globaltradeforce.com"]
