# ─── DEV .env TEMPLATE — copy to backend/.env on the DEV site, then fill ───────
# Safe to commit (no secrets). Real backend/.env is gitignored.
#   cp .env.dev.template .env   &&   nano .env

# ─── Application ───────────────────────────────────────────
APP_NAME="Wholesale ERP (DEV)"
APP_VERSION="1.0.0"
DEBUG=true                          # dev: enables /api/docs + SQL echo
# Generate on the server:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=__PASTE_GENERATED_SECRET_KEY__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database (separate DB from prod) ────────────────────────────────────────
DATABASE_URL=mysql+pymysql://erpuserdev:__DB_PASSWORD__@localhost:3306/wholesaleerpdev?charset=utf8mb4

# ─── File Storage (dev site user home) ───────────────────────────────────────
UPLOAD_DIR=/home/gtferp-dev/GTF/backend/uploads
EXPORT_DIR=/home/gtferp-dev/GTF/backend/exports
MAX_UPLOAD_SIZE_MB=10

# ─── Company Info ────────────────────────────────────────────────────────────
COMPANY_NAME="Global Trade Force (DEV)"
COMPANY_GSTIN=29AAAAA0000A1Z5
COMPANY_STATE=Karnataka
COMPANY_STATE_CODE=29
COMPANY_ADDRESS="123, Business Street, City - 560001"
COMPANY_CITY=Bangalore
COMPANY_PINCODE=560001
COMPANY_PHONE=+91-9999999999
COMPANY_EMAIL=accounts@globaltradeforce.com
FINANCIAL_YEAR_START_MONTH=4

# ─── Cleartax / GST (sandbox in dev — never hit the live IRP from dev) ───────
CLEARTAX_SANDBOX=true
CLEARTAX_AUTH_TOKEN=
CLEARTAX_GSTIN=

# ─── CORS ────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://dev.erp.globaltradeforce.com
ALLOWED_ORIGINS=["https://dev.erp.globaltradeforce.com"]
