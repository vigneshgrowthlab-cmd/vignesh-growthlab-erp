# Vite reads this automatically during `npm run build` (production mode).
# Same-origin deploy: SPA and API share https://erp.vigneshgrowthlab.com,
# so all /api/v1/... and /uploads/... calls hit the same host (no CORS).
# This value is public (baked into the JS bundle) — safe to commit.
VITE_API_URL=https://erp.vigneshgrowthlab.com
